# Copy to `.env.local` for local development. Never commit real secrets.
# Production values live in Vercel → Project Settings → Environment Variables.

# Express API origin (used for /backend-api rewrites and Google OAuth)
BACKEND_URL=http://localhost:5050
NEXT_PUBLIC_API_URL=http://localhost:5050

# Better Auth — must be the public client URL in production
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Long random secret for signing Better Auth sessions (generate a new one per environment)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# MongoDB used by Better Auth (same database as the Express API)
MONGODB_URI=mongodb://127.0.0.1:27017/rentora
